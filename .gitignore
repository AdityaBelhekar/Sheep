# dependencies
node_modules/

# build output
dist/
out/
.vite/
*.tsbuildinfo

# test / tooling caches
coverage/
.eslintcache
.vitest/

# local data (Sheep writes its own store under the user data path)
.sheep/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# secrets and local env
.env
.env.*
!.env.example
Keys

# editors / os
.DS_Store
Thumbs.db
*.log

# bundled python runtime (fetched by packages/sandbox/scripts/fetch-runtime.mjs)
packages/sandbox/runtime/
packages/sandbox/.runtime-cache/

# bundled rendering tools (fetched by packages/artifacts/scripts/fetch-tools.mjs)
packages/artifacts/tools/
packages/artifacts/.tools-cache/
