{
  "name": "sheep",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A multi-model sandbox for genuine, original AI-driven research.",
  "license": "MIT",
  "author": "Aditya Belhekar",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run dev --workspace @sheep/desktop",
    "build": "npm run build --workspace @sheep/desktop",
    "start": "npm run start --workspace @sheep/desktop",
    "smoke": "npm run smoke --workspace @sheep/desktop",
    "fetch-runtime": "npm run fetch-runtime --workspace @sheep/sandbox",
    "fetch-tools": "npm run fetch-tools --workspace @sheep/artifacts",
    "dist": "npm run dist --workspace @sheep/desktop --",
    "smoke:packaged": "npm run smoke:packaged --workspace @sheep/desktop",
    "acceptance": "npm run acceptance --workspace @sheep/desktop --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}
