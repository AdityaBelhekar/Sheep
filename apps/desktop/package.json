{
  "name": "@sheep/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sheep desktop application: Electron main, preload and React renderer.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@sheep/core": "*",
    "@sheep/gateway": "*",
    "@sheep/ipc": "*",
    "@sheep/orchestrator": "*",
    "@sheep/sandbox": "*",
    "@sheep/store": "*",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.6"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  }
}
